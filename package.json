{
  "name": "catbot-desktop",
  "productName": "Catbot",
  "version": "0.1.0",
  "private": true,
  "description": "Billu, the voice-driven Catbot desktop agent",
  "author": "Hacksmith",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node desktop/launch.cjs",
    "start:fake": "node desktop/launch.cjs --fake",
    "package": "node desktop/package.mjs",
    "test": "node --test desktop/tests/*.test.cjs",
    "smoke:electron": "node desktop/launch.cjs --probe",
    "format:desktop": "prettier --write desktop catbot/ui/audio.js catbot/ui/desktop.js"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@resvg/resvg-js": "2.6.2",
    "electron": "45.2.1",
    "prettier": "3.6.2"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
